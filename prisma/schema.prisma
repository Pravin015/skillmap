generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  TRAINER
  COMPANY
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum DeliveryMode {
  ONSITE
  VIRTUAL
  HYBRID
}

enum CertStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

enum CompanyType {
  DIRECT
  TRAINING_PARTNER
}

enum MemberRole {
  OWNER
  RECRUITER
}

enum Visibility {
  PUBLIC
  INVITE_ONLY
}

enum ReqStatus {
  OPEN
  SHORTLISTING
  AWARDED
  COMPLETED
  CANCELLED
}

enum AppStatus {
  APPLIED
  SHORTLISTED
  AWARDED
  DECLINED
  WITHDRAWN
}

enum ConnStatus {
  PENDING
  ACCEPTED
  IGNORED
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  avatarUrl    String?
  passwordHash String?
  role         Role
  status       UserStatus @default(ACTIVE)
  emailNotifications Boolean @default(true)
  phone              String?
  whatsappAlerts     Boolean @default(false)
  referralCode       String?  @unique
  referredById       String?
  referredBy         User?    @relation("Referrals", fields: [referredById], references: [id])
  referrals          User[]   @relation("Referrals")
  identityVerifiedAt DateTime?
  identityDocUrl     String?
  identityNote       String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  trainerProfile   TrainerProfile?
  membership       CompanyMember?
  postedRequirements Requirement[]
  comments         Comment[]
  sentConnections  Connection[] @relation("ConnRequester")
  gotConnections   Connection[] @relation("ConnAddressee")
  conversations    ConversationParticipant[]
  messages         Message[]
  ratingsGiven     Rating[] @relation("RatingFrom")
  ratingsReceived  Rating[] @relation("RatingTo")
  notifications    Notification[]
  auditLogs        AuditLog[]
  reviewedCerts    Certification[] @relation("CertReviewer")
  oauthAccounts    OAuthAccount[]
  posts            Post[]
  postLikes        PostLike[]
  postComments     PostComment[]
  following        Follow[] @relation("Follower")
  followers        Follow[] @relation("FollowedUser")
  subscriptions    Subscription[]
  reports          Report[]    @relation("Reporter")
  resolvedReports  Report[]    @relation("Resolver")
  feedbackLinks    FeedbackLink[]
  recommendationsWritten Recommendation[] @relation("RecAuthor")
  workOrdersCreated WorkOrder[]
  workOrderEvents  WorkOrderEvent[]
  invoicesIssued   Invoice[]
  emailLogs        EmailLog[]
  savedSearches    SavedSearch[]
  interviewsProposed Interview[]
  pushSubscriptions PushSubscription[]
  referralRewards  ReferralReward[]
  smsLogs          SmsLog[]
}

model Recommendation {
  id            String       @id @default(cuid())
  trainerId     String
  trainer       TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  authorId      String
  author        User         @relation("RecAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  companyId     String?
  company       Company?     @relation(fields: [companyId], references: [id])
  requirementId String?
  requirement   Requirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  relationship  String
  body          String
  visible       Boolean      @default(true)
  createdAt     DateTime     @default(now())

  @@unique([trainerId, authorId])
}

enum WorkOrderStatus {
  DRAFT
  SENT
  CHANGES_REQUESTED
  ACCEPTED
  CANCELLED
}

model WorkOrder {
  id                String          @id @default(cuid())
  number            Int             @default(autoincrement())
  requirementId     String          @unique
  requirement       Requirement     @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  trainerId         String
  trainer           TrainerProfile  @relation(fields: [trainerId], references: [id])
  companyId         String
  company           Company         @relation(fields: [companyId], references: [id])
  createdById       String
  createdBy         User            @relation(fields: [createdById], references: [id])
  version           Int             @default(1)
  status            WorkOrderStatus @default(DRAFT)
  title             String
  startDate         DateTime
  endDate           DateTime
  days              Int
  dayRate           Int
  currency          String          @default("INR")
  total             Int
  participants      Int
  mode              DeliveryMode
  venue             String          @default("")
  deliverables      String          @default("")
  provided          String          @default("")
  paymentTerms      String          @default("")
  cancellationTerms String          @default("")
  notes             String          @default("")
  sentAt            DateTime?
  acceptedAt        DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  events   WorkOrderEvent[]
  invoices Invoice[]
}

model WorkOrderEvent {
  id          String    @id @default(cuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  actorId     String
  actor       User      @relation(fields: [actorId], references: [id])
  type        String
  note        String?
  version     Int
  createdAt   DateTime  @default(now())
}

enum BlockKind {
  BOOKED
  UNAVAILABLE
  TENTATIVE
}

model AvailabilityBlock {
  id            String       @id @default(cuid())
  trainerId     String
  trainer       TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  startDate     DateTime
  endDate       DateTime
  kind          BlockKind    @default(BOOKED)
  note          String?
  requirementId String?
  requirement   Requirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())

  @@index([trainerId, startDate])
}

enum CourseLevel {
  FOUNDATION
  INTERMEDIATE
  ADVANCED
}

model Course {
  id              String         @id @default(cuid())
  trainerId       String
  trainer         TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  title           String
  summary         String
  outline         String         @default("")
  level           CourseLevel    @default(INTERMEDIATE)
  durationDays    Int            @default(1)
  modes           DeliveryMode[] @default([])
  maxParticipants Int?
  indicativeRate  Int?
  currency        String         @default("INR")
  outlineUrl      String?
  categoryId      String?
  category        Category?      @relation(fields: [categoryId], references: [id])
  skills          Skill[]
  published       Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model FeedbackLink {
  id            String      @id @default(cuid())
  token         String      @unique
  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  trainerId     String
  trainer       TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  createdById   String
  createdBy     User        @relation(fields: [createdById], references: [id])
  expiresAt     DateTime
  maxResponses  Int         @default(200)
  createdAt     DateTime    @default(now())

  responses FeedbackResponse[]
}

model FeedbackResponse {
  id             String       @id @default(cuid())
  linkId         String
  link           FeedbackLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  score          Int
  wouldRecommend Boolean
  comment        String?
  fingerprint    String?
  createdAt      DateTime     @default(now())
}

model TrainerStatDaily {
  trainerId         String
  trainer           TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  date              DateTime       @db.Date
  profileViews      Int            @default(0)
  searchAppearances Int            @default(0)

  @@id([trainerId, date])
}

enum ReportTarget {
  POST
  POST_COMMENT
  REQUIREMENT
  COMMENT
  USER
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model Report {
  id           String       @id @default(cuid())
  reporterId   String
  reporter     User         @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType   ReportTarget
  targetId     String
  reason       String
  detail       String?
  status       ReportStatus @default(OPEN)
  resolvedById String?
  resolvedBy   User?        @relation("Resolver", fields: [resolvedById], references: [id])
  resolution   String?
  createdAt    DateTime     @default(now())
  resolvedAt   DateTime?

  @@index([status, createdAt])
}

enum PlanCode {
  TRAINER_PRO
  COMPANY_GROWTH
  PARTNER
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum SubStatus {
  CREATED
  AUTHENTICATED
  ACTIVE
  PENDING
  HALTED
  CANCELLED
  COMPLETED
  EXPIRED
}

model Subscription {
  id                     String          @id @default(cuid())
  userId                 String?
  user                   User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId              String?
  company                Company?        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan                   PlanCode
  interval               BillingInterval
  status                 SubStatus       @default(CREATED)
  amount                 Int
  currency               String          @default("INR")
  razorpaySubscriptionId String?         @unique
  razorpayPlanId         String?
  razorpayCustomerId     String?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean         @default(false)
  simulated              Boolean         @default(false)
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  payments Payment[]
}

model Payment {
  id                String       @id @default(cuid())
  subscriptionId    String
  subscription      Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  razorpayPaymentId String?      @unique
  amount            Int
  currency          String       @default("INR")
  status            String
  method            String?
  invoiceId         String?
  createdAt         DateTime     @default(now())
}

model WebhookEvent {
  id          String   @id @default(cuid())
  eventId     String   @unique
  type        String
  payload     Json
  processedAt DateTime @default(now())
}

model Post {
  id         String    @id @default(cuid())
  authorId   String
  author     User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  companyId  String?
  company    Company?  @relation(fields: [companyId], references: [id])
  body       String
  imageUrl   String?
  docUrl     String?
  docName    String?
  repostOfId String?
  repostOf   Post?     @relation("Reposts", fields: [repostOfId], references: [id], onDelete: Cascade)
  reposts    Post[]    @relation("Reposts")
  likes      PostLike[]
  comments   PostComment[]
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?

  @@index([createdAt])
}

model PostLike {
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([postId, userId])
}

model PostComment {
  id        String    @id @default(cuid())
  postId    String
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime  @default(now())
  deletedAt DateTime?
}

model Follow {
  id              String   @id @default(cuid())
  followerId      String
  follower        User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followingUserId String?
  followingUser   User?    @relation("FollowedUser", fields: [followingUserId], references: [id], onDelete: Cascade)
  companyId       String?
  company         Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())

  @@unique([followerId, followingUserId])
  @@unique([followerId, companyId])
}

model OAuthAccount {
  id                String   @id @default(cuid())
  provider          String
  providerAccountId String
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email             String?
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
}

model TrainerProfile {
  id               String         @id @default(cuid())
  userId           String         @unique
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug             String         @unique
  headline         String
  bio              String         @default("")
  cities           String[]       @default([])
  deliveryModes    DeliveryMode[] @default([])
  languages        String[]       @default([])
  yearsExperience  Int            @default(0)
  dayRateMin       Int?
  dayRateMax       Int?
  currency         String         @default("INR")
  availabilityNote String?
  verifiedAt       DateTime?
  gstin            String?
  paymentDetails   String?
  videoUrl         String?
  createdAt        DateTime       @default(now())

  skills         Skill[]
  certifications Certification[]
  applications   Application[]
  invitedTo      Requirement[]   @relation("RequirementInvites")
  savedBy        SavedTrainer[]
  availability   AvailabilityBlock[]
  courses        Course[]
  feedbackLinks  FeedbackLink[]
  stats          TrainerStatDaily[]
  recommendations Recommendation[]
  workOrders     WorkOrder[]
  photos         GalleryPhoto[]
  invoices       Invoice[]
}

model Certification {
  id           String     @id @default(cuid())
  trainerId    String
  trainer      TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  name         String
  issuer       String
  credentialId String?
  issuedOn     DateTime?
  expiresOn    DateTime?
  fileUrl      String?
  status       CertStatus @default(PENDING)
  reviewNote   String?
  reviewedById String?
  reviewedBy   User?      @relation("CertReviewer", fields: [reviewedById], references: [id])
  expiryRemindedAt DateTime?
  createdAt    DateTime   @default(now())
}

model Company {
  id               String      @id @default(cuid())
  slug             String      @unique
  name             String
  logoUrl          String?
  industry         String      @default("")
  size             String      @default("")
  website          String?
  cities           String[]    @default([])
  type             CompanyType @default(DIRECT)
  domain           String?
  domainVerifiedAt DateTime?
  gstin            String?
  gstVerifiedAt    DateTime?
  billingAddress   String?
  description      String      @default("")
  createdAt        DateTime    @default(now())

  members      CompanyMember[]
  requirements Requirement[]
  saved        SavedTrainer[]
  posts        Post[]
  followers    Follow[]
  subscriptions Subscription[]
  recommendations Recommendation[]
  workOrders   WorkOrder[]
  photos       GalleryPhoto[]
  invoices     Invoice[]
}

model CompanyMember {
  id        String     @id @default(cuid())
  companyId String
  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      MemberRole @default(RECRUITER)
  joinedAt  DateTime   @default(now())
}

model Category {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  requirements Requirement[]
  courses      Course[]
  skills       Skill[]
  description  String        @default("")
}

model Skill {
  id           String           @id @default(cuid())
  name         String
  slug         String           @unique
  categoryId   String?
  category     Category?        @relation(fields: [categoryId], references: [id])
  vendor       String?
  trainers     TrainerProfile[]
  requirements Requirement[]
  courses      Course[]
}

model Requirement {
  id           String       @id @default(cuid())
  companyId    String
  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  postedById   String
  postedBy     User         @relation(fields: [postedById], references: [id])
  title        String
  description  String
  categoryId   String
  category     Category     @relation(fields: [categoryId], references: [id])
  skills       Skill[]
  mode         DeliveryMode
  city         String?
  startDate    DateTime
  endDate      DateTime
  days         Int
  participants Int
  budgetMin    Int?
  budgetMax    Int?
  currency     String       @default("INR")
  language     String       @default("English")
  visibility   Visibility   @default(PUBLIC)
  status       ReqStatus    @default(OPEN)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  invitedTrainers TrainerProfile[] @relation("RequirementInvites")
  applications    Application[]
  comments        Comment[]
  ratings         Rating[]
  conversations   Conversation[]
  blocks          AvailabilityBlock[]
  feedbackLinks   FeedbackLink[]
  recommendations Recommendation[]
  workOrder       WorkOrder?
}

model Application {
  id              String    @id @default(cuid())
  requirementId   String
  requirement     Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  trainerId       String
  trainer         TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  coverNote       String
  proposedRate    Int?
  status          AppStatus @default(APPLIED)
  declineReason   String?
  statusChangedAt DateTime  @default(now())
  createdAt       DateTime  @default(now())

  interview Interview?

  @@unique([requirementId, trainerId])
}

model Comment {
  id            String      @id @default(cuid())
  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  authorId      String
  author        User        @relation(fields: [authorId], references: [id])
  parentId      String?
  parent        Comment?    @relation("Replies", fields: [parentId], references: [id])
  replies       Comment[]   @relation("Replies")
  body          String
  createdAt     DateTime    @default(now())
  deletedAt     DateTime?
}

model Connection {
  id          String     @id @default(cuid())
  requesterId String
  requester   User       @relation("ConnRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String
  addressee   User       @relation("ConnAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  status      ConnStatus @default(PENDING)
  createdAt   DateTime   @default(now())
  respondedAt DateTime?

  @@unique([requesterId, addresseeId])
}

model Conversation {
  id            String       @id @default(cuid())
  requirementId String?
  requirement   Requirement? @relation(fields: [requirementId], references: [id])
  lastMessageAt DateTime     @default(now())
  createdAt     DateTime     @default(now())

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?

  @@id([conversationId, userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  body           String
  attachmentUrl  String?
  attachmentName String?
  createdAt      DateTime     @default(now())
}

model Rating {
  id            String      @id @default(cuid())
  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  fromUserId    String
  fromUser      User        @relation("RatingFrom", fields: [fromUserId], references: [id])
  toUserId      String
  toUser        User        @relation("RatingTo", fields: [toUserId], references: [id])
  score         Int
  review        String?
  createdAt     DateTime    @default(now())

  @@unique([requirementId, fromUserId, toUserId])
}

model SavedTrainer {
  companyId String
  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  trainerId String
  trainer   TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@id([companyId, trainerId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id])
  action    String
  target    String
  detail    Json?
  createdAt DateTime @default(now())
}

model Setting {
  key   String @id
  value String
}

model GalleryPhoto {
  id            String         @id @default(cuid())
  trainerId     String
  trainer       TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  url           String
  caption       String         @default("")
  takenOn       DateTime?
  companyId     String?
  company       Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  createdAt     DateTime       @default(now())
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  CANCELLED
}

model Invoice {
  id            String         @id @default(cuid())
  number        Int            @default(autoincrement())
  invoiceNumber String
  workOrderId   String
  workOrder     WorkOrder      @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  trainerId     String
  trainer       TrainerProfile @relation(fields: [trainerId], references: [id])
  companyId     String
  company       Company        @relation(fields: [companyId], references: [id])
  issuedById    String
  issuedBy      User           @relation(fields: [issuedById], references: [id])
  description   String
  amount        Int
  gstRate       Int            @default(18)
  gstAmount     Int            @default(0)
  total         Int
  currency      String         @default("INR")
  trainerGstin  String?
  companyGstin  String?
  paymentDetails String        @default("")
  notes         String         @default("")
  status        InvoiceStatus  @default(SENT)
  issuedAt      DateTime       @default(now())
  dueDate       DateTime
  paidAt        DateTime?
  paidReference String?
  createdAt     DateTime       @default(now())
}

model EmailLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  to         String
  subject    String
  status     String
  providerId String?
  error      String?
  createdAt  DateTime @default(now())
}

enum SearchKind {
  TRAINERS
  REQUIREMENTS
}

model SavedSearch {
  id             String     @id @default(cuid())
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind           SearchKind
  name           String
  params         Json
  alerts         Boolean    @default(true)
  lastNotifiedAt DateTime?
  createdAt      DateTime   @default(now())
}

enum InterviewStatus {
  PROPOSED
  CONFIRMED
  DECLINED
  CANCELLED
}

enum InterviewMode {
  VIDEO
  PHONE
  ONSITE
}

model Interview {
  id              String          @id @default(cuid())
  applicationId   String          @unique
  application     Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  proposedById    String
  proposedBy      User            @relation(fields: [proposedById], references: [id])
  status          InterviewStatus @default(PROPOSED)
  mode            InterviewMode   @default(VIDEO)
  location        String          @default("")
  durationMin     Int             @default(30)
  note            String          @default("")
  responseNote    String?
  confirmedSlotId String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  slots InterviewSlot[]
}

model InterviewSlot {
  id          String    @id @default(cuid())
  interviewId String
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  startsAt    DateTime
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
}

model ReferralReward {
  id          String   @id @default(cuid())
  referrerId  String
  referrer    User     @relation(fields: [referrerId], references: [id], onDelete: Cascade)
  referredId  String   @unique
  qualifiedAt DateTime @default(now())
  reward      String
}

model SmsLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  to        String
  channel   String
  body      String
  status    String
  error     String?
  createdAt DateTime @default(now())
}

model JobRun {
  id        String   @id @default(cuid())
  name      String
  ranAt     DateTime @default(now())
  summary   String
}
